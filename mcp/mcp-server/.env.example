# Savetrix MCP server configuration. Copy to .env and fill in.
# The web app's NEXT_PUBLIC_* vars are unrelated — this server is standalone.

# Base URL of the Savetrix REST API (same as the web app's NEXT_PUBLIC_API_URL).
SAVETRIX_API_URL=https://api.savetrix.com/api

# Web app URL surfaced in savetrix_get_started for browser sign-in/sign-up.
SAVETRIX_WEB_URL=https://scantrix.ai

# Optional: pre-authenticate at startup with app credentials. If omitted,
# call the savetrix_login tool (or set SAVETRIX_ACCESS_TOKEN below).
SAVETRIX_EMAIL=
SAVETRIX_PASSWORD=

# Optional: a token pair already obtained from a logged-in session.
# Prefer SAVETRIX_EMAIL/SAVETRIX_PASSWORD or the savetrix_login tool.
SAVETRIX_ACCESS_TOKEN=
SAVETRIX_REFRESH_TOKEN=

# Optional: pin the QuickBooks connection to use (X-QB-Id). If omitted, the
# first connection from GET /qb-connections is used (mirrors the web app).
SAVETRIX_QB_CONNECTION_ID=

# HTTP mode only: if set, every /mcp request must send
# "Authorization: Bearer <this value>" or it is rejected with 401.
SAVETRIX_MCP_API_KEY=

# HTTP mode only: port to listen on.
SAVETRIX_PORT=8000
